<Project Sdk="Microsoft.NET.Sdk">


  <ItemGroup>
    <!-- IHttpContextAccessor / HttpContext (TenantAwareRepository, TenantContextHelper) come from
         the shared framework on net9 — replaces the legacy ASP.NET Core 2.2 Http packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Every module configures its DbContext through NexcoreDbContextOptions, which needs
         the PostgreSQL provider and the snake_case naming rewriter. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Accounting\" />
  </ItemGroup>

</Project>
